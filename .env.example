# Supabase project credentials.
#
# These are baked into the WASM at BUILD TIME via option_env!(), so set them
# in your shell / CI / Vercel build environment before running `trunk build`.
#
# For local development without a rebuild you can alternatively put the same
# values into localStorage under these keys (see src/core/supabase.rs):
#   medsup_supabase_url
#   medsup_supabase_anon
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
